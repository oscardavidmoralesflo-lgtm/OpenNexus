# Copy to .env.ops in the repository directory on the server (chmod 600).
# It is gitignored. Keep a copy of BACKUP_PASSPHRASE in your password manager:
# without it the backups cannot be opened.

# Backblaze B2: an application key limited to the backup bucket.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_PREFIX=opennexus
BACKUP_KEEP_DAYS=30
# At least 16 characters; encrypts each backup before it leaves the server.
BACKUP_PASSPHRASE=

# Where operational alerts go (comma-separated). The e-mail is sent with the
# SMTP_* settings of .env.docker. Set the same ALERT_EMAIL in .env.docker for
# the app's own alerts (WhatsApp lines disconnected, banned or paused).
ALERT_EMAIL=

# Optional: how to call Compose and what to probe.
# OPS_COMPOSE=docker compose --env-file .env.docker
# HEALTH_API_URL=http://127.0.0.1:8000/health
# HEALTH_WEB_URL=http://127.0.0.1:3000/
